{
  "name": "estrenos-es",
  "productName": "Estrenos ES",
  "version": "1.1.1",
  "description": "Estrenos semanales de las plataformas de streaming en España, con notas de crítica, géneros, tráiler en castellano y valoración personal por criterios.",
  "author": "LordPanZ",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "agent": "npm run build:main && node dist/main/agent-cli.cjs",
    "android:open": "npx cap open android",
    "build": "npm run build:renderer && npm run build:main",
    "build:android": "npm run build:renderer && npx cap sync android",
    "build:main": "node scripts/build-main.mjs",
    "build:main:watch": "node scripts/build-main.mjs --watch",
    "build:renderer": "vite build",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint src scripts tests --ext .ts,.tsx",
    "package": "npm run build && electron-builder --publish never",
    "package:all": "npm run build && electron-builder -mwl --publish never",
    "smoke": "xvfb-run -a electron --no-sandbox scripts/smoke/main.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "6.0.2",
    "@capacitor/browser": "6.0.4",
    "@capacitor/core": "6.2.0",
    "@capacitor/filesystem": "6.0.2",
    "@capacitor/preferences": "6.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/cli": "6.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
